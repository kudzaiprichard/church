# Postgres connection string used by Prisma and the app.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/church?schema=public"

# Resend — https://resend.com/api-keys
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend.
EMAIL_FROM="Church <noreply@example.com>"

# Public base URL, used for links inside emails and notifications.
APP_URL="http://localhost:3000"

# The first administrator. Read once on server start, and only when the users
# table contains no admin at all — after that the account exists and these are
# ignored. Remove them from the environment once you have signed in; the
# running system does not need them.
#
# The password must be at least 12 characters. The account is created with
# "must change password" set, so it has to be replaced at first sign-in.
BOOTSTRAP_ADMIN_EMAIL="admin@example.org"
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME="Church Office"
