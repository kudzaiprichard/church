// Church Management System — data model
// Draft translation of "Church Management System.pdf" (see docs/).
// Key system rule: admins see everything; members see only their own data
// plus data explicitly targeted at them. Every model below is designed so
// that rule can be enforced with a scope filter on the query.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Modules 1 & 2 — Authentication, Users & Members
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MEMBER
}

model User {
  id String @id @default(cuid())

  email String @unique
  // Null until the member accepts their invite and chooses a password. Login
  // treats a null hash as "invited, not yet activated" rather than as a
  // credential failure.
  passwordHash String?
  firstName    String
  lastName     String
  phone        String?
  role         Role    @default(MEMBER)
  avatarUrl    String?

  // Set when an admin resets someone's password by hand. The invite flow does
  // not need it, because an invited member chooses their own password before
  // they ever sign in.
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  lastLoginAt        DateTime?

  // Throttling for online guessing. Cleared on every successful sign-in.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  joinedAt  DateTime @default(now())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions         Session[]
  authTokens       AuthToken[]
  groupMemberships GroupMembership[]
  sentMessages     Message[]          @relation("MessageSender")
  receivedMessages MessageRecipient[]
  messageReplies   MessageReply[]
  attendance       AttendanceRecord[]
  contributions    Contribution[]
  partnerships     Partnership[]
  prayerRequests   PrayerRequest[]
  sermonNotes      SermonNote[]
  notifications    Notification[]
  createdEvents    Event[]            @relation("EventCreator")
  createdGroups    Group[]            @relation("GroupCreator")
  uploadedSermons  Sermon[]           @relation("SermonUploader")

  @@index([role])
}

/// A signed-in browser.
///
/// Sessions live in the database rather than in a signed token because the
/// spec lets an admin deactivate a member and change anyone's role — and both
/// have to take effect on the next request, which a self-contained token
/// cannot do. Only the SHA-256 of the session token is stored, so a dump of
/// this table does not hand anyone a working session.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum AuthTokenPurpose {
  INVITE
  PASSWORD_RESET
}

/// A single-use link sent by email — either an invitation to choose a first
/// password, or a reset for a forgotten one. Same machinery for both; only the
/// purpose, the wording and the lifetime differ.
///
/// Stored as a hash for the same reason sessions are.
model AuthToken {
  id        String           @id @default(cuid())
  tokenHash String           @unique
  userId    String
  purpose   AuthTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Module 4 — Connect Groups
// ---------------------------------------------------------------------------

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy      User              @relation("GroupCreator", fields: [createdById], references: [id])
  members        GroupMembership[]
  messages       Message[]
  events         EventAudience[]
  prayerRequests PrayerRequest[]
}

model GroupMembership {
  id       String   @id @default(cuid())
  userId   String
  groupId  String
  isLeader Boolean  @default(false)
  joinedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
}

// ---------------------------------------------------------------------------
// Module 3 — Communication (Inbox)
// A message is authored once and fanned out into MessageRecipient rows, so a
// member's inbox is a single query scoped to their own user id.
// ---------------------------------------------------------------------------

enum MessageAudience {
  ALL
  GROUP
  INDIVIDUAL
}

model Message {
  id        String          @id @default(cuid())
  senderId  String
  subject   String
  body      String
  audience  MessageAudience
  groupId   String?
  sentAt    DateTime        @default(now())
  createdAt DateTime        @default(now())

  sender     User               @relation("MessageSender", fields: [senderId], references: [id])
  group      Group?             @relation(fields: [groupId], references: [id])
  recipients MessageRecipient[]
  replies    MessageReply[]

  @@index([senderId])
  @@index([groupId])
}

model MessageRecipient {
  id        String    @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
}

model MessageReply {
  id        String   @id @default(cuid())
  messageId String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// ---------------------------------------------------------------------------
// Module 5 — Events
// ---------------------------------------------------------------------------

enum EventScope {
  GENERAL
  GROUP
}

model Event {
  id          String     @id @default(cuid())
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  scope       EventScope @default(GENERAL)
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  createdBy  User               @relation("EventCreator", fields: [createdById], references: [id])
  audiences  EventAudience[]
  attendance AttendanceRecord[]

  @@index([startsAt])
}

model EventAudience {
  id      String @id @default(cuid())
  eventId String
  groupId String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([eventId, groupId])
}

// ---------------------------------------------------------------------------
// Module 6 — Prayer Requests
// ---------------------------------------------------------------------------

model PrayerRequest {
  id         String   @id @default(cuid())
  authorId   String
  groupId    String
  body       String
  isPinned   Boolean  @default(false)
  isAnswered Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  group  Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, isPinned])
}

// ---------------------------------------------------------------------------
// Module 7 — Attendance
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

model AttendanceRecord {
  id          String           @id @default(cuid())
  userId      String
  eventId     String?
  serviceName String?
  status      AttendanceStatus @default(PRESENT)
  recordedAt  DateTime         @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([userId, recordedAt])
  @@index([eventId])
}

// ---------------------------------------------------------------------------
// Module 8 — Tithes & Offerings
// ---------------------------------------------------------------------------

enum ContributionType {
  TITHE
  OFFERING
}

model Contribution {
  id        String           @id @default(cuid())
  userId    String
  type      ContributionType
  amount    Decimal          @db.Decimal(12, 2)
  currency  String           @default("USD")
  note      String?
  givenAt   DateTime         @default(now())
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, givenAt])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Module 9 — Partnerships & Promises
// ---------------------------------------------------------------------------

enum PartnershipStatus {
  ACTIVE
  FULFILLED
  LAPSED
  CANCELLED
}

model Partnership {
  id            String            @id @default(cuid())
  userId        String
  title         String
  pledgedAmount Decimal           @db.Decimal(12, 2)
  currency      String            @default("USD")
  status        PartnershipStatus @default(ACTIVE)
  startedAt     DateTime          @default(now())
  dueAt         DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments PartnershipPayment[]

  @@index([userId, status])
}

model PartnershipPayment {
  id            String   @id @default(cuid())
  partnershipId String
  amount        Decimal  @db.Decimal(12, 2)
  paidAt        DateTime @default(now())
  note          String?

  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@index([partnershipId])
}

// ---------------------------------------------------------------------------
// Modules 10 & 11 — Sermons and Personal Notes
// ---------------------------------------------------------------------------

enum SermonMediaType {
  AUDIO
  VIDEO
}

model Sermon {
  id           String          @id @default(cuid())
  title        String
  speaker      String?
  description  String?
  mediaType    SermonMediaType
  mediaUrl     String
  thumbnailUrl String?
  preachedAt   DateTime?
  isPublished  Boolean         @default(false)
  uploadedById String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  uploadedBy User         @relation("SermonUploader", fields: [uploadedById], references: [id])
  notes      SermonNote[]

  @@index([isPublished, preachedAt])
}

// Personal to the author — the spec says notes are not shared.
model SermonNote {
  id        String   @id @default(cuid())
  userId    String
  sermonId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sermon Sermon @relation(fields: [sermonId], references: [id], onDelete: Cascade)

  @@unique([userId, sermonId])
}

// ---------------------------------------------------------------------------
// Module 12 — Notifications & Reminders
// ---------------------------------------------------------------------------

enum NotificationType {
  MESSAGE
  EVENT
  EVENT_REMINDER
  GROUP_ACTIVITY
  PRAYER_REQUEST
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
