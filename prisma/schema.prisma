// Church Management System — data model
// Draft translation of the requirements; the target model is docs/SCOPE.md §6.
// Key system rule: admins see everything; members see only their own data
// plus data explicitly targeted at them. Every model below is designed so
// that rule can be enforced with a scope filter on the query.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Modules 1 & 2 — Authentication, Users & Members
// ---------------------------------------------------------------------------

/// The office a person holds. Group leadership is not an office — it is
/// `Group.leaderId`, so a leader's powers are always tied to one group.
/// See docs/SCOPE.md §4.
enum Role {
  APOSTLE
  MATRON
  ELDER
  MEMBER
}

enum Gender {
  MALE
  FEMALE
}

model User {
  id String @id @default(cuid())

  email        String    @unique
  // Null until the member accepts their invite and chooses a password. Login
  // treats a null hash as "invited, not yet activated" rather than as a
  // credential failure.
  passwordHash String?
  firstName    String
  lastName     String
  phone        String?
  address      String?
  /// Date only — a birthday has no time zone. Birthday logic reads it in
  /// Harare time (docs/SCOPE.md §9.15).
  dateOfBirth  DateTime? @db.Date
  gender       Gender?
  role         Role      @default(MEMBER)
  avatarUrl    String?

  // Set when an admin resets someone's password by hand. The invite flow does
  // not need it, because an invited member chooses their own password before
  // they ever sign in.
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  lastLoginAt        DateTime?

  // Throttling for online guessing. Cleared on every successful sign-in.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  joinedAt  DateTime @default(now())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions              Session[]
  authTokens            AuthToken[]
  auditActions          AuditLog[]           @relation("AuditActor")
  auditSubjects         AuditLog[]           @relation("AuditTarget")
  groupMemberships      GroupMembership[]
  ledGroups             Group[]              @relation("GroupLeader")
  baptismalRecord       BaptismalRecord?
  settingsUpdates       ChurchSettings[]     @relation("SettingsUpdater")
  themeUpdates          ThemeOfYear[]        @relation("ThemeUpdater")
  sentMessages          Message[]            @relation("MessageSender")
  receivedMessages      MessageRecipient[]
  repliesWritten        MessageReply[]       @relation("ReplyAuthor")
  replyThreads          MessageReply[]       @relation("ReplyThread")
  attendance            AttendanceRecord[]
  attendanceMarked      AttendanceRecord[]   @relation("AttendanceMarker")
  contributions         Contribution[]
  contributionsRecorded Contribution[]       @relation("ContributionRecorder")
  contributionsReviewed Contribution[]       @relation("ContributionReviewer")
  pledges               Pledge[]
  createdProjects       PartnershipProject[] @relation("ProjectCreator")
  prayerRequests        PrayerRequest[]
  sermonNotes           SermonNote[]
  notifications         Notification[]
  createdEvents         Event[]              @relation("EventCreator")
  uploadedSermons       Sermon[]             @relation("SermonUploader")

  @@index([role])
  @@index([isActive])
}

/// Proof of baptism, created with the member at enrolment.
///
/// Only the baptized may be enrolled, so every member enrolled through the
/// portal has exactly one. Accounts that predate enrolment (the bootstrapped
/// Apostle, people invited before Phase 0) may not, which is why the relation
/// is optional on `User` rather than enforced by the database. Certificate
/// fields arrive with the baptism module (Phase 5).
model BaptismalRecord {
  id               String    @id @default(cuid())
  userId           String    @unique
  baptismDate      DateTime  @db.Date
  location         String
  conductedBy      String
  classCompletedOn DateTime? @db.Date
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A signed-in browser.
///
/// Sessions live in the database rather than in a signed token because the
/// spec lets an admin deactivate a member and change anyone's role — and both
/// have to take effect on the next request, which a self-contained token
/// cannot do. Only the SHA-256 of the session token is stored, so a dump of
/// this table does not hand anyone a working session.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum AuthTokenPurpose {
  INVITE
  PASSWORD_RESET
}

/// A single-use link sent by email — either an invitation to choose a first
/// password, or a reset for a forgotten one. Same machinery for both; only the
/// purpose, the wording and the lifetime differ.
///
/// Stored as a hash for the same reason sessions are.
model AuthToken {
  id        String           @id @default(cuid())
  tokenHash String           @unique
  userId    String
  purpose   AuthTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

enum AuditAction {
  ADMIN_BOOTSTRAPPED
  USER_INVITED
  INVITE_RESENT
  PASSWORD_RESET_SENT
  ROLE_CHANGED
  USER_DEACTIVATED
  USER_REACTIVATED
  ACCOUNT_LOCKED
  MEMBER_ENROLLED
  MEMBER_UPDATED
  THEME_UPDATED
  SETTINGS_UPDATED
  GROUP_CREATED
  GROUP_UPDATED
  GROUP_DELETED
  GROUP_LEADER_CHANGED
  EVENT_DELETED
  PRAYER_REQUEST_REMOVED
  CONTRIBUTION_CONFIRMED
  CONTRIBUTION_REJECTED
  CONTRIBUTION_RECORDED_FOR_MEMBER
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_COMPLETED
  PLEDGE_CANCELLED
  FINANCE_EXPORTED
}

/// Who did what to whom.
///
/// Admins can see every member's giving, change anyone's role and switch
/// accounts off. Those are exactly the powers that need a record, and the
/// record has to outlive the people in it — so the actor and target emails are
/// copied in as text rather than only referenced. Delete the account and the
/// row still says what happened; the foreign keys go null and the story stays
/// readable.
///
/// Nothing here is ever edited or deleted by the application. It is append-only
/// by construction: there is no update path in the codebase.
model AuditLog {
  id     String      @id @default(cuid())
  action AuditAction

  /// Null when the system itself acted — the first-administrator bootstrap has
  /// no signed-in person behind it.
  actorId    String?
  actorEmail String?

  targetId    String?
  targetEmail String?

  /// Free text for the specifics: "MEMBER → ADMIN", and so on.
  detail String?

  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  actor  User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  target User? @relation("AuditTarget", fields: [targetId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetId])
  @@index([action])
}

// ---------------------------------------------------------------------------
// Module 4 — Connect Groups
// ---------------------------------------------------------------------------

/// One of the seven connect groups.
///
/// Leadership is `leaderId`, not a flag on the membership: a group has one
/// leader, and "who leads Youth Alive?" must have one answer. Null is shown as
/// Vacant. Changing it changes that person's powers on their next request,
/// because nothing about leadership is cached on the session.
model Group {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String   @unique
  audience    String?
  description String?
  leaderId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leader         User?             @relation("GroupLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members        GroupMembership[]
  messages       Message[]
  events         Event[]
  prayerRequests PrayerRequest[]

  @@index([leaderId])
}

model GroupMembership {
  id       String   @id @default(cuid())
  userId   String
  groupId  String
  joinedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
}

// ---------------------------------------------------------------------------
// Module 3 — Communication (Inbox)
// A message is authored once and fanned out into MessageRecipient rows, so a
// member's inbox is a single query scoped to their own user id. Recipients are
// resolved when the message is sent: somebody who joins a group later does not
// receive what was sent to it before (docs/SCOPE.md §9.5).
// ---------------------------------------------------------------------------

enum MessageAudience {
  ALL
  GROUP
  INDIVIDUAL
}

model Message {
  id        String          @id @default(cuid())
  senderId  String
  subject   String
  body      String
  audience  MessageAudience
  groupId   String?
  sentAt    DateTime        @default(now())
  createdAt DateTime        @default(now())

  sender     User               @relation("MessageSender", fields: [senderId], references: [id])
  // Deleting a group keeps the messages sent to it; their recipients were
  // fixed at send time, so nobody's inbox changes.
  group      Group?             @relation(fields: [groupId], references: [id], onDelete: SetNull)
  recipients MessageRecipient[]
  replies    MessageReply[]

  @@index([senderId, sentAt])
  @@index([groupId])
}

model MessageRecipient {
  id        String    @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
}

/// A reply belongs to a private thread between the message's sender and ONE
/// recipient (`threadUserId`). Other recipients of a group message never see
/// it — replying to an announcement is a conversation, not a reply-all.
model MessageReply {
  id           String    @id @default(cuid())
  messageId    String
  /// The recipient whose conversation with the sender this is.
  threadUserId String
  /// That recipient, or the original sender answering them.
  authorId     String
  body         String
  createdAt    DateTime  @default(now())
  /// When the other party in the thread read it.
  readAt       DateTime?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  author  User    @relation("ReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  thread  User    @relation("ReplyThread", fields: [threadUserId], references: [id], onDelete: Cascade)

  @@index([messageId, threadUserId, createdAt])
}

// ---------------------------------------------------------------------------
// Module 5 — Events
// ---------------------------------------------------------------------------

/// An all-church event (`groupId` null) or one group's. Everyone sees the
/// all-church ones and those of the groups they belong to; Apostles see all
/// (`groupContentScope`). Only Apostles create them (docs/SCOPE.md §11 Q9).
model Event {
  id             String    @id @default(cuid())
  title          String
  description    String?
  location       String?
  startsAt       DateTime
  endsAt         DateTime?
  /// Null = All Church. Deleting a group keeps its past events, unassigned.
  groupId        String?
  createdById    String
  /// Set by the reminder job (Phase 5) so a rerun does not remind twice.
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  group      Group?             @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdBy  User               @relation("EventCreator", fields: [createdById], references: [id])
  attendance AttendanceRecord[]

  @@index([startsAt])
  @@index([groupId, startsAt])
}

// ---------------------------------------------------------------------------
// Module 6 — Prayer Requests
// ---------------------------------------------------------------------------

/// Visible only to members of the group and to Apostles (docs/SCOPE.md §9.8).
model PrayerRequest {
  id         String   @id @default(cuid())
  authorId   String
  groupId    String
  body       String
  isPinned   Boolean  @default(false)
  isAnswered Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  group  Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, isPinned, createdAt])
}

// ---------------------------------------------------------------------------
// Module 7 — Attendance
// ---------------------------------------------------------------------------

/// "Excused" is deliberately not offered: the rate is present over marked,
/// and a third state would leave every leader to decide what it counts as.
enum AttendanceStatus {
  PRESENT
  ABSENT
}

/// One person at one event. Marked by that group's leader or an Apostle; for
/// an all-church event each leader marks their own group's members.
model AttendanceRecord {
  id         String           @id @default(cuid())
  userId     String
  eventId    String
  status     AttendanceStatus
  markedById String
  markedAt   DateTime         @default(now())

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event    Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  markedBy User  @relation("AttendanceMarker", fields: [markedById], references: [id])

  @@unique([userId, eventId])
  @@index([eventId])
}

// ---------------------------------------------------------------------------
// Modules 8 & 9 — Finance: contributions, partnership projects and pledges
// (docs/SCOPE.md §9.9–9.10). Money is Decimal(12,2) in USD. Amounts raised and
// paid are always computed from CONFIRMED contributions, never stored.
// ---------------------------------------------------------------------------

enum ContributionType {
  CHEMA
  WELFARE
  TITHE
  PARTNERSHIP
}

enum ContributionStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/// One payment by one member. Members log their own (PENDING until an Apostle
/// or the Elder confirms, SCOPE §11 Q2); officers record cash handed in
/// (CONFIRMED). A confirmed row is never edited or deleted: a mistake is
/// corrected by an officer's reversing entry — a negative amount pointing at
/// the row it reverses through `reversalOfId`.
///
/// Enforced in the migration's raw SQL, not expressible here:
///   * one non-rejected chema per member per month (a partial unique index
///     that ignores reversals)
///   * CHEMA rows carry a year and a 1–12 month, others carry neither; a
///     PARTNERSHIP row names a project
model Contribution {
  id           String             @id @default(cuid())
  userId       String
  type         ContributionType
  amount       Decimal            @db.Decimal(12, 2)
  currency     String             @default("USD")
  paidAt       DateTime           @db.Date
  note         String?
  chemaYear    Int?
  chemaMonth   Int?
  projectId    String?
  pledgeId     String?
  status       ContributionStatus @default(PENDING)
  recordedById String
  reviewedById String?
  reviewedAt   DateTime?
  rejectReason String?
  /// Set on a reversing entry: the confirmed contribution it cancels out.
  reversalOfId String?            @unique
  createdAt    DateTime           @default(now())

  user       User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  project    PartnershipProject? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  pledge     Pledge?             @relation(fields: [pledgeId], references: [id], onDelete: SetNull)
  recordedBy User                @relation("ContributionRecorder", fields: [recordedById], references: [id])
  reviewedBy User?               @relation("ContributionReviewer", fields: [reviewedById], references: [id])
  reversalOf Contribution?       @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy Contribution?       @relation("Reversal")

  @@index([userId, paidAt])
  @@index([type, status, paidAt])
  @@index([chemaYear, chemaMonth])
  @@index([projectId])
  @@index([pledgeId])
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

/// A church fundraising goal. Progress is confirmed partnership giving ÷ target.
model PartnershipProject {
  id           String        @id @default(cuid())
  name         String        @unique
  description  String?
  targetAmount Decimal       @db.Decimal(12, 2)
  startDate    DateTime      @db.Date
  endDate      DateTime?     @db.Date
  status       ProjectStatus @default(ACTIVE)
  completedAt  DateTime?
  /// Null for the projects the seed creates before any account exists.
  createdById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  contributions Contribution[]
  pledges       Pledge[]
  createdBy     User?          @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
}

/// "Overdue" is derived (active, past due, not fully paid), never stored.
enum PledgeStatus {
  ACTIVE
  FULFILLED
  CANCELLED
}

/// A member's promise to give a total by a date. Paid = confirmed
/// contributions linked to it; FULFILLED is set when paid reaches the total.
model Pledge {
  id          String       @id @default(cuid())
  userId      String
  projectId   String?
  description String
  totalAmount Decimal      @db.Decimal(12, 2)
  dueDate     DateTime     @db.Date
  status      PledgeStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  project       PartnershipProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contributions Contribution[]

  @@index([userId, status])
  @@index([dueDate, status])
}

// ---------------------------------------------------------------------------
// Modules 10 & 11 — Sermons and Personal Notes
// ---------------------------------------------------------------------------

enum SermonMediaType {
  AUDIO
  VIDEO
}

model Sermon {
  id           String          @id @default(cuid())
  title        String
  speaker      String?
  description  String?
  mediaType    SermonMediaType
  mediaUrl     String
  thumbnailUrl String?
  preachedAt   DateTime?
  isPublished  Boolean         @default(false)
  uploadedById String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  uploadedBy User         @relation("SermonUploader", fields: [uploadedById], references: [id])
  notes      SermonNote[]

  @@index([isPublished, preachedAt])
}

// Personal to the author — the spec says notes are not shared.
model SermonNote {
  id        String   @id @default(cuid())
  userId    String
  sermonId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sermon Sermon @relation(fields: [sermonId], references: [id], onDelete: Cascade)

  @@unique([userId, sermonId])
}

// ---------------------------------------------------------------------------
// Module 12 — Notifications & Reminders
// ---------------------------------------------------------------------------

enum NotificationType {
  MESSAGE
  MESSAGE_REPLY
  EVENT
  EVENT_REMINDER
  GROUP_ACTIVITY
  PRAYER_REQUEST
  DEVOTION
  BIRTHDAY
  PLEDGE_REMINDER
  CONTRIBUTION_REVIEWED
}

/// Written only through `notify()` in src/lib/notifications.ts.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  /// An internal path only; the layout drops anything else before rendering.
  linkUrl   String?
  /// Set by senders that may run twice (scheduled reminders), so the second
  /// run writes nothing: "event-reminder:<event>:<user>".
  dedupeKey String?          @unique
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// ---------------------------------------------------------------------------
// Settings — church information, Theme of the Year, social links
// (docs/SCOPE.md §9.17–9.19). Read through src/lib/settings.ts, cached under
// the "church-settings" tag and invalidated on every save.
// ---------------------------------------------------------------------------

/// The church's own details. A single row whose id is always "church".
model ChurchSettings {
  id          String   @id @default("church")
  name        String
  shortName   String
  tagline     String?
  mission     String?
  vision      String?
  doctrine    String?
  address     String?
  phone       String?
  email       String?
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("SettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// One year's theme. The current theme is the one with the highest year;
/// earlier years are the history shown under it.
model ThemeOfYear {
  id           String   @id @default(cuid())
  year         Int      @unique
  title        String
  scriptureRef String
  verseText    String
  description  String?
  updatedById  String?
  updatedAt    DateTime @updatedAt

  updatedBy User? @relation("ThemeUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Twitter/X is deliberately not offered (SCOPE §9.18).
enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  YOUTUBE
  WHATSAPP
}

model SocialLink {
  platform  SocialPlatform @id
  handle    String
  url       String
  isVisible Boolean        @default(true)
  updatedAt DateTime       @updatedAt
}
